--- !u!114 &2110618132
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2110618129}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3656c2a8b0f344a7848f49c481a99587, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogo
  lineas:
  - sinNombre: 0
    personaje: Lady Li Hua
    texto: "\u201CEs admirable tu valor para entrar aqu\xED y querer conocer los
      saberes olvidados. Los dem\xE1s maestros no tuvieron la misma suerte que yo,
      ver\xE1s...\u201D"
    ilustracion: {fileID: 0}
  - sinNombre: 0
    personaje: Lady Li Hua
    texto: "\u201Ccomo mi estatua no fue completamente destruida, creo que a\xFAn
      recuerdo un par de trucos que podr\xEDan servirte para comenzar este camino.
      A ver... \xBFc\xF3mo eran?...\u201D"
    ilustracion: {fileID: 0}
  distancia: {x: 2, y: 2.5}
  centro: {x: 0, y: 0}
  tecla: 19
  cartelInteractuar: {fileID: 4250720034094768461, guid: e75e8e08518b2ad43bc257cd2da52b06, type: 3}
  posicionCartel: {x: 0, y: 1.6}
  indicador: {fileID: 0}
  soloUnaVez: 1
  abrirAlEntrar: 0
  alTerminar:
    m_PersistentCalls:
      m_Calls: []
