  m_Script: {fileID: 11500000, guid: 3656c2a8b0f344a7848f49c481a99587, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogo
  lineas:
  - sinNombre: 0
    personaje: Jaya
    texto: "\u201CParece que la crecida trajo ruinas de todos los templos de las
      antiguas artes.\u201D"
    ilustracion: {fileID: 0}
  - sinNombre: 0
    personaje: Jaya
    texto: "\u201C\xA1Qu\xE9 pena! Si esto sigue as\xED, pronto no quedar\xE1 nada
      de los conocimientos que alguna vez guardaron.\u201D"
    ilustracion: {fileID: 0}
