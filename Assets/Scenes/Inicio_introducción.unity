  m_Script: {fileID: 11500000, guid: 3656c2a8b0f344a7848f49c481a99587, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogo
  lineas:
  - sinNombre: 0
    personaje: Jaya
    texto: "\u201CParece que la crecida del r\xEDo trajo objetos que nunca hab\xEDa
      visto. Que raro...\u201D"
    ilustracion: {fileID: 0}
  - sinNombre: 0
    personaje: Jaya
    texto: "\u201C\xBFEso de all\xE1 es un portal? \xBFA d\xF3nde llevar\xE1?\u201D"
    ilustracion: {fileID: 0}
  distancia: {x: 3.5, y: 3}
